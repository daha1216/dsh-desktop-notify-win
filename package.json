{
  "name": "dsh-desktop-notify-win",
  "version": "0.5.0",
  "type": "module",
  "description": "Windows desktop notifications for DeepSeek Harness: idle, approval, question and error alerts, with a settings page, live preview and presets.",
  "license": "MIT",
  "author": "xiaotie3088",
  "homepage": "https://github.com/daha1216/dsh-desktop-notify-win",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daha1216/dsh-desktop-notify-win.git"
  },
  "bugs": {
    "url": "https://github.com/daha1216/dsh-desktop-notify-win/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-notification",
    "windows",
    "toast",
    "notification"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "notify.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "lib/*.js"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/config.js && node --check lib/history.js && node --check lib/log.js && node --check lib/paths.js && node --check lib/renderer-host.js && node --check lib/schema.js && node --check lib/service.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
